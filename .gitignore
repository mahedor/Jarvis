# Secrets
.env

# Python
__pycache__/
*.pyc
.venv/

# Logs (runtime only — benchmark artifacts now live in results/).
# The /logs/* form is anchored to the repo root, so demo/logs/ needs its own rule.
/logs/*
demo/logs/

# Datasets (WIDER FACE / FDDB / MAFA — download separately, never commit)
data/

# Face-detection test images & sanity-check outputs
tools/images/*
!tools/images/.gitkeep
tools/output/

# Model weights (large binaries — download separately, never commit)
tools/weights/
*.pt
*.tflite

# OS
.DS_Store
Thumbs.db

# Claude Code
.claude/

# Dependencies
node_modules/

# Linter caches
.ruff_cache/
.eslintcache